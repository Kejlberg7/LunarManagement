# Neon pooled connection string
DATABASE_URL=

# At least 32 random characters. Signs secure session cookies and login links.
SESSION_SECRET=

# SMTP credentials deliver first-time password setup and password reset links.
# Leave blank locally to show the setup link in the development UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Lunar Holdmanager <login@example.com>
APP_URL=http://localhost:3000

# Set true only for local development when no mail service is configured.
DEV_SHOW_LOGIN_LINK=false

# First account with this email becomes owner of the pilot team.
BOOTSTRAP_ADMIN_EMAIL=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
